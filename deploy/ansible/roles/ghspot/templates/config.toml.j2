# Managed by Ansible — edits here are overwritten on the next run.
# Change the role's variables instead.

[github]
api_url = "{{ ghspot_api_url }}"
{% if ghspot_github_app_id | length > 0 %}
app_id = "{{ ghspot_github_app_id }}"
{% endif %}

[daemon]
poll_interval = "{{ ghspot_poll_interval }}"
state_db = "{{ ghspot_state_db }}"
log_level = "{{ ghspot_log_level }}"
log_format = "json"
{% if ghspot_api_bind | length > 0 %}
api_bind = "{{ ghspot_api_bind }}"
{% endif %}

[housekeeping]
enabled = {{ ghspot_housekeeping.enabled | bool | lower }}
every = "{{ ghspot_housekeeping.every }}"
volumes = {{ ghspot_housekeeping.volumes | bool | lower }}
{# Each sweep can be turned off individually with "never"; the daemon reads that as "do not". #}
{% for key in ['containers_older_than', 'images_older_than', 'build_cache_older_than'] %}
{% set age = ghspot_housekeeping[key] | default('never') %}
{{ key }} = "{{ 'never' if age in [none, false, '', 'never'] else age }}"
{% endfor %}
{% if ghspot_housekeeping.keep_build_cache is defined and ghspot_housekeeping.keep_build_cache %}
keep_build_cache = "{{ ghspot_housekeeping.keep_build_cache }}"
{% endif %}
{% for pool in ghspot_pools %}

[[pool]]
name = "{{ pool.name }}"
repository = "{{ pool.repository }}"
labels = [{{ pool.labels | map('tojson') | join(', ') }}]
min_idle = {{ pool.min_idle | default(0) }}
max_runners = {{ pool.max_runners | default(2) }}
idle_timeout = "{{ pool.idle_timeout | default('10m') }}"
max_job_duration = "{{ pool.max_job_duration | default('2h') }}"
max_launch_per_tick = {{ pool.max_launch_per_tick | default(2) }}
{% if pool.requires_labels is defined and pool.requires_labels %}
requires_labels = [{{ pool.requires_labels | map('tojson') | join(', ') }}]
{% endif %}

[pool.container]
image = "{{ pool.container.image }}"
{% if pool.container.cpus is defined %}
cpus = {{ pool.container.cpus }}
{% endif %}
{% if pool.container.memory is defined %}
memory = "{{ pool.container.memory }}"
{% endif %}
docker_socket = {{ pool.container.docker_socket | default(false) | bool | lower }}
{% if pool.container.gpus is defined and pool.container.gpus %}
{% if pool.container.gpus is string %}
gpus = "{{ pool.container.gpus }}"
{% elif pool.container.gpus is sequence %}
gpus = [{{ pool.container.gpus | map('string') | map('tojson') | join(', ') }}]
{% else %}
gpus = {{ pool.container.gpus }}
{% endif %}
{% endif %}
{% if pool.container.network is defined %}
network = "{{ pool.container.network }}"
{% endif %}
{% if pool.container.volumes is defined %}

[pool.container.volumes]
{% for host_path, container_path in pool.container.volumes.items() %}
"{{ host_path }}" = "{{ container_path }}"
{% endfor %}
{% endif %}
{% endfor %}
