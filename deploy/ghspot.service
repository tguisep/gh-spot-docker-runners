# Install to /etc/systemd/system/ghspot.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ghspot
#
#   sudo systemctl reload ghspot    # apply a config change, runners untouched
#   sudo systemctl restart ghspot   # replace the fleet as well
#
# Runs as an unprivileged user that is a member of the 'docker' group. That group
# membership is equivalent to root on this host, so the user should exist for this
# purpose and nothing else.
#
# ExecStart expects a virtualenv at /opt/ghspot/.venv, so the daemon does not depend on
# any human's home directory — the ghspot user cannot read yours. See docs/operations.md
# for the install steps. If you installed elsewhere, change the path below.

[Unit]
Description=ghspot — self-hosted GitHub Actions runners on Docker
Documentation=https://github.com/tguisep/gh-spot-docker-runners
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

# Give up after five rapid failures rather than retrying forever. A configuration mistake
# would otherwise loop every ten seconds, burying the one useful line in the journal under
# thousands of identical ones. Failing loudly is what gets it looked at.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ghspot
Group=ghspot
SupplementaryGroups=docker

ExecStart=/opt/ghspot/.venv/bin/ghspot daemon --config /etc/ghspot/config.toml

# The credential is read from this file rather than passed as an argument, so it never
# appears in `ps` or in the journal.
#   GHSPOT_GITHUB_TOKEN=github_pat_...
# or GHSPOT_GITHUB_APP_ID= and GHSPOT_GITHUB_APP_PRIVATE_KEY=
#
# Prefixed with "-" so a missing file is not an error. Without it systemd refuses to start
# the unit at all, and the journal says only that the environment file could not be read —
# which tells an operator far less than ghspot's own "no GitHub token: set ... or ..." does.
EnvironmentFile=-/etc/ghspot/env

Restart=always
RestartSec=10s

# On stop the daemon takes the fleet with it: the host is the master, and a runner outliving
# the process that made it keeps taking jobs with nothing enforcing its timeouts. Jobs in
# flight fail and have to be re-run — the deliberate trade, since a CI run can be replayed and
# a fleet nobody owns cannot be reasoned about.
#
# The timeout covers finishing the current tick plus stopping every container. They are
# stopped concurrently, so this is one container's grace period and not the sum of them.
KillSignal=SIGTERM
TimeoutStopSec=300

# Reload is the one that does not touch runners: it re-reads the configuration and applies the
# pools, labels and ceilings in place. Use it for a configuration change; use restart when you
# mean to replace the fleet.
ExecReload=/bin/kill -HUP $MAINPID

StateDirectory=ghspot

# 0750, matching what the package creates. Left at systemd's 0755 default the two disagree,
# and every start logs "ConfigurationDirectory 'ghspot' already exists but the mode is
# different" — a line that says something is wrong about the directory holding the
# credentials, on a unit that is working perfectly.
ConfigurationDirectory=ghspot
ConfigurationDirectoryMode=0750

# The daemon needs the Docker socket and its own state. It needs nothing else.
#
# ReadWritePaths is "-" prefixed for the same reason: a path that does not exist is an error
# otherwise, so a host where Docker is not running yet fails with 226/NAMESPACE and no
# indication that the socket is what is missing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=-/var/run/docker.sock

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
