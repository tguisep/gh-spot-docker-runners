# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown; trimming them changes the rendering.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
