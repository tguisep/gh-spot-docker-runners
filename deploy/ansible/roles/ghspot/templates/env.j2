# Managed by Ansible — edits here are overwritten on the next run.
#
# Read by systemd as an EnvironmentFile, which is why an App key is escaped: the format
# cannot hold real newlines.
{% for credential in ghspot_github_credentials %}
{# The same suffix `_credential_env()` computes in ghspot itself: the credential named
   "default" keeps the bare variable; any other gets its name, uppercased, anything that is
   not alphanumeric folded to `_`. Keep the two in step. #}
{% set suffix = '' if credential.name == 'default' else '_' + (credential.name | upper | regex_replace('[^A-Z0-9]+', '_')) %}
{% if credential.token is defined and credential.token | length > 0 %}
GHSPOT_GITHUB_TOKEN{{ suffix }}={{ credential.token }}
{% else %}
GHSPOT_GITHUB_APP_ID{{ suffix }}={{ credential.app_id }}
GHSPOT_GITHUB_APP_PRIVATE_KEY{{ suffix }}={{ credential.private_key | replace('\n', '\\n') }}
{% endif %}
{% endfor %}
{% if ghspot_web_root is defined and ghspot_web_root | length > 0 %}

# Where the dashboard was built. Only set when it is not the packaged location: an explicit
# value is authoritative, so a typo here serves nothing rather than falling back.
GHSPOT_WEB_ROOT={{ ghspot_web_root }}
{% endif %}
