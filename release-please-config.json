{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "ghspot",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "bump-minor-pre-major": true,
      "draft": true,
      "prerelease": false,
      "extra-files": [
        "src/ghspot/__init__.py"
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "ci",
      "section": "Build and CI"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ],
  "pull-request-title-pattern": "chore: release v${version}",
  "pull-request-header": ":package: Merging this pull request cuts the release: it creates the tag and a draft release, builds the amd64 and arm64 packages, attaches them, and publishes last. A published release is immutable, so the assets have to be on it before it goes out."
}
