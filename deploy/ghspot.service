# Install to /etc/systemd/system/ghspot.service, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ghspot
#
# Runs as an unprivileged user that is a member of the 'docker' group. That group
# membership is equivalent to root on this host, so the user should exist for this
# purpose and nothing else.
#
# ExecStart expects a virtualenv at /opt/ghspot/.venv, so the daemon does not depend on
# any human's home directory — the ghspot user cannot read yours. See docs/operations.md
# for the install steps. If you installed elsewhere, change the path below.

[Unit]
Description=ghspot — self-hosted GitHub Actions runners on Docker
Documentation=https://github.com/tguisep/gh-spot-docker-runners
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

# Give up after five rapid failures rather than retrying forever. A configuration mistake
# would otherwise loop every ten seconds, burying the one useful line in the journal under
# thousands of identical ones. Failing loudly is what gets it looked at.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ghspot
Group=ghspot
SupplementaryGroups=docker

ExecStart=/opt/ghspot/.venv/bin/ghspot daemon --config /etc/ghspot/config.toml

# The credential is read from this file rather than passed as an argument, so it never
# appears in `ps` or in the journal.
#   GHSPOT_GITHUB_TOKEN=github_pat_...
# or GHSPOT_GITHUB_APP_ID= and GHSPOT_GITHUB_APP_PRIVATE_KEY=
#
# Prefixed with "-" so a missing file is not an error. Without it systemd refuses to start
# the unit at all, and the journal says only that the environment file could not be read —
# which tells an operator far less than ghspot's own "no GitHub token: set ... or ..." does.
EnvironmentFile=-/etc/ghspot/env

Restart=always
RestartSec=10s

# Runners mid-job are somebody's CI run. On stop, the daemon finishes its current tick
# and leaves busy containers alone; this is how long we wait before insisting.
KillSignal=SIGTERM
TimeoutStopSec=300

StateDirectory=ghspot
ConfigurationDirectory=ghspot

# The daemon needs the Docker socket and its own state. It needs nothing else.
#
# ReadWritePaths is "-" prefixed for the same reason: a path that does not exist is an error
# otherwise, so a host where Docker is not running yet fails with 226/NAMESPACE and no
# indication that the socket is what is missing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=-/var/run/docker.sock

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
