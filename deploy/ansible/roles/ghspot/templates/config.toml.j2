# Managed by Ansible — edits here are overwritten on the next run.
# Change the role's variables instead.
{% if ghspot_pools_in_directory | default(false) | bool %}

{# Above the first [section]: TOML gives a bare key to whichever table precedes it. #}
include = "{{ ghspot_pools_directory }}/*.toml"
{% endif %}

{# Secrets for every credential are never written here; they go to env.j2 as
   GHSPOT_GITHUB_*(_<NAME>) variables, which is what lets this file be world-readable without
   being a credential itself. Only the public shape (name, api_url, app_id) lives in the TOML —
   every credential the same way, the one named "default" included. #}
{% for credential in ghspot_github_credentials %}

[[github.credentials]]
name = "{{ credential.name }}"
{% if credential.api_url is defined and credential.api_url %}
api_url = "{{ credential.api_url }}"
{% endif %}
{% if credential.app_id is defined and credential.app_id %}
app_id = "{{ credential.app_id }}"
{% endif %}
{% endfor %}

[daemon]
poll_interval = "{{ ghspot_poll_interval }}"
state_db = "{{ ghspot_state_db }}"
log_level = "{{ ghspot_log_level }}"
log_format = "json"
{% if ghspot_api_bind | length > 0 %}
api_bind = "{{ ghspot_api_bind }}"
{% endif %}
{# Left out when unset, so the daemon falls back to the system hostname rather than to an
   empty string that would leave every report unlabelled. #}
{% if ghspot_host | length > 0 %}
host = "{{ ghspot_host }}"
{% endif %}

[housekeeping]
enabled = {{ ghspot_housekeeping.enabled | bool | lower }}
every = "{{ ghspot_housekeeping.every }}"
volumes = {{ ghspot_housekeeping.volumes | bool | lower }}
{# Each sweep can be turned off individually with "never"; the daemon reads that as "do not". #}
{% for key in ['containers_older_than', 'images_older_than', 'build_cache_older_than'] %}
{% set age = ghspot_housekeeping[key] | default('never') %}
{{ key }} = "{{ 'never' if age in [none, false, '', 'never'] else age }}"
{% endfor %}
{% if ghspot_housekeeping.keep_build_cache is defined and ghspot_housekeeping.keep_build_cache %}
keep_build_cache = "{{ ghspot_housekeeping.keep_build_cache }}"
{% endif %}
{# One table for the whole host, so it must sit outside the pool loop. #}
{% if ghspot_capacity is defined and ghspot_capacity %}

[capacity]
{% for key, value in ghspot_capacity.items() %}
{% if value is string %}
{{ key }} = "{{ value }}"
{% else %}
{{ key }} = {{ value }}
{% endif %}
{% endfor %}
{% endif %}
{% if not (ghspot_pools_in_directory | default(false) | bool) %}
{% for pool in ghspot_pools %}
{% include '_pool.toml.j2' %}
{% endfor %}
{% endif %}
